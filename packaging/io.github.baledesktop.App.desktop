[Desktop Entry]
Type=Application
Name=Bale Desktop
Name[fa]=بله دسکتاپ
Comment=Bale Web with multiple accounts and background notifications
Exec=bale-desktop %u
Icon=io.github.baledesktop.App
Terminal=false
Categories=Network;InstantMessaging;
StartupNotify=true
MimeType=x-scheme-handler/bale;x-scheme-handler/ble;
StartupWMClass=BaleDesktop
DBusActivatable=false
Actions=Background;

[Desktop Action Background]
Name=Run in background
Name[fa]=اجرا در پس‌زمینه
Exec=bale-desktop --background
